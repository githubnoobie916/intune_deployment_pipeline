{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-lifecycle/release-acceptance.v1.schema.json",
  "title": "Release acceptance evidence v1",
  "description": "Shape only; supplied acceptance must pass endpoint/business and every declared prerequisite with matching file hashes. Pending examples cannot authorize publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "applicationId",
    "buildId",
    "packageSha256",
    "detectionSha256",
    "endpoint",
    "business",
    "prerequisites"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "ReleaseAcceptance"
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "detectionSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "approvedBy",
        "approvedAtUtc",
        "evidence"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "approvedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvedAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "approvedBy",
        "approvedAtUtc",
        "evidence"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "approvedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvedAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementHash",
          "approvedBy",
          "approvedAtUtc",
          "evidence"
        ],
        "properties": {
          "requirementHash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "approvedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
