{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-lifecycle/application-build.v1.schema.json",
  "title": "application-build v1",
  "description": "Frozen local record. Embedded definition/release schema snapshots are checked against their source schemas by tests; internal references require no external resolution. Shape validation is separate from seals, content identity, provenance and runtime acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applicationId",
    "buildId",
    "fixture",
    "definitionSha256",
    "discoveryFingerprint",
    "release",
    "definition",
    "inputs",
    "implementations",
    "profile",
    "identity",
    "publication",
    "provenance",
    "recordHash",
    "recordType",
    "status",
    "inputSnapshots",
    "sourceFolder",
    "sourceInventory",
    "detection",
    "templateValidationPath",
    "createdAtUtc",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "applicationId": {
      "$ref": "#/$defs/text"
    },
    "buildId": {
      "$ref": "#/$defs/sha256"
    },
    "fixture": {
      "type": "boolean"
    },
    "definitionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "discoveryFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "release": {
      "$ref": "#/$defs/discoveredRelease"
    },
    "definition": {
      "$ref": "#/$defs/applicationDefinition"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "implementations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementation"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "recordHash": {
      "$ref": "#/$defs/sha256"
    },
    "recordType": {
      "const": "ApplicationBuild"
    },
    "status": {
      "const": "Complete"
    },
    "inputSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "relativePath",
          "sha256",
          "originalSource"
        ],
        "properties": {
          "role": {
            "enum": [
              "action",
              "detection",
              "support",
              "installer"
            ]
          },
          "path": {
            "$ref": "#/$defs/absolutePath"
          },
          "relativePath": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "originalSource": {
            "$ref": "#/$defs/absolutePath"
          }
        }
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "sourceFolder": {
      "$ref": "#/$defs/absolutePath"
    },
    "sourceInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "minItems": 223,
      "uniqueItems": true
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sourceSha256",
        "version"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "$ref": "#/$defs/numericVersion"
        }
      }
    },
    "templateValidationPath": {
      "$ref": "#/$defs/absolutePath"
    },
    "createdAtUtc": {
      "$ref": "#/$defs/dateTime"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static",
        "endpoint",
        "business",
        "packaging",
        "tenant"
      ],
      "properties": {
        "static": {
          "const": true
        },
        "endpoint": {
          "const": false
        },
        "business": {
          "const": false
        },
        "packaging": {
          "const": false
        },
        "tenant": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "numericVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){1,3}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000-\\u001F]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^<>:\"|?*\\u0000-\\u001F]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "applicationDefinition": {
      "title": "Application definition v3 — manual PSADT 4.1.8 native-v2 profile",
      "description": "One authored application definition. Scripts own executable commands. Release versions, validation decisions, generated metadata and tenant state are separate outputs. This schema validates supported shape; semantic, filesystem, evidence and runtime checks are separate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "publisher",
        "productName",
        "displayName",
        "description",
        "ownership",
        "source",
        "variant",
        "validation",
        "toolkit",
        "deployment",
        "actions",
        "payloads",
        "detection",
        "intune",
        "targets",
        "update"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "publisher": {
          "$ref": "#/$defs/applicationDefinition/$defs/text"
        },
        "productName": {
          "$ref": "#/$defs/applicationDefinition/$defs/text"
        },
        "displayName": {
          "$ref": "#/$defs/applicationDefinition/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/applicationDefinition/$defs/text"
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "team",
            "contact",
            "recipeRevision"
          ],
          "properties": {
            "team": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "contact": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "recipeRevision": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "application",
            "moduleVersion",
            "definitionsRelease",
            "selectionMap",
            "selectionConstants",
            "parameterMap"
          ],
          "properties": {
            "provider": {
              "const": "Evergreen"
            },
            "application": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "moduleVersion": {
              "const": "2610.2859.0"
            },
            "definitionsRelease": {
              "const": "v26.11.03.146"
            },
            "selectionMap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "Architecture",
                "Type"
              ],
              "properties": {
                "Architecture": {
                  "const": "architecture"
                },
                "Type": {
                  "const": "installerType"
                },
                "Channel": {
                  "const": "channel"
                },
                "Language": {
                  "const": "language"
                }
              }
            },
            "selectionConstants": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "InstallerType": {
                  "$ref": "#/$defs/applicationDefinition/$defs/text"
                },
                "UriSuffix": {
                  "type": "string",
                  "pattern": "^\\.[^\\\\/]+$"
                }
              }
            },
            "parameterMap": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "Language": {
                  "const": "language"
                }
              }
            }
          }
        },
        "variant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edition",
            "channel",
            "language",
            "architecture",
            "installerType",
            "versionPolicy",
            "targetVersion"
          ],
          "properties": {
            "edition": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "channel": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "language": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "architecture": {
              "const": "x64"
            },
            "installerType": {
              "enum": [
                "msi",
                "exe"
              ]
            },
            "versionPolicy": {
              "enum": [
                "latest",
                "pinned"
              ]
            },
            "targetVersion": {
              "anyOf": [
                {
                  "$ref": "#/$defs/applicationDefinition/$defs/numericVersion"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "versionPolicy": {
                    "const": "latest"
                  }
                }
              },
              "then": {
                "properties": {
                  "targetVersion": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "targetVersion": {
                    "$ref": "#/$defs/applicationDefinition/$defs/numericVersion"
                  }
                }
              }
            }
          ]
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedDownloadHosts",
            "requireVendorSha256",
            "requireAuthenticode",
            "approvedSignerSubjects",
            "expectedProductName",
            "msiPropertiesToRecord"
          ],
          "properties": {
            "allowedDownloadHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "requireVendorSha256": {
              "type": "boolean"
            },
            "requireAuthenticode": {
              "type": "boolean"
            },
            "approvedSignerSubjects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/applicationDefinition/$defs/text"
              },
              "uniqueItems": true
            },
            "expectedProductName": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "msiPropertiesToRecord": {
              "type": "array",
              "items": {
                "enum": [
                  "ProductName",
                  "ProductVersion",
                  "ProductCode",
                  "UpgradeCode",
                  "Manufacturer",
                  "ProductLanguage"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "toolkit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "profile",
            "packageRevision",
            "scriptVersion",
            "scriptDate",
            "scriptAuthor",
            "requireAdmin",
            "successExitCodes",
            "rebootExitCodes"
          ],
          "properties": {
            "version": {
              "const": "4.1.8"
            },
            "profile": {
              "const": "official-4.1.8-native-v2"
            },
            "packageRevision": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "scriptVersion": {
              "$ref": "#/$defs/applicationDefinition/$defs/numericVersion"
            },
            "scriptDate": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "scriptAuthor": {
              "$ref": "#/$defs/applicationDefinition/$defs/text"
            },
            "requireAdmin": {
              "const": true
            },
            "successExitCodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/applicationDefinition/$defs/exitCode"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "rebootExitCodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/applicationDefinition/$defs/exitCode"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context",
            "mode",
            "processes",
            "deferral",
            "repair",
            "prerequisites",
            "externalPolicyPrerequisites"
          ],
          "properties": {
            "context": {
              "const": "system"
            },
            "mode": {
              "const": "Auto"
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/applicationDefinition/$defs/text"
                  },
                  "description": {
                    "$ref": "#/$defs/applicationDefinition/$defs/text"
                  }
                }
              },
              "uniqueItems": true
            },
            "deferral": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy"
              ],
              "properties": {
                "policy": {
                  "const": "template-default"
                }
              }
            },
            "repair": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "supported",
                "reason"
              ],
              "properties": {
                "supported": {
                  "const": false
                },
                "reason": {
                  "$ref": "#/$defs/applicationDefinition/$defs/text"
                }
              }
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/applicationDefinition/$defs/text"
              }
            },
            "externalPolicyPrerequisites": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "setting",
                  "requiredValue"
                ],
                "properties": {
                  "provider": {
                    "const": "Intune"
                  },
                  "setting": {
                    "$ref": "#/$defs/applicationDefinition/$defs/text"
                  },
                  "requiredValue": {
                    "type": [
                      "string",
                      "boolean",
                      "number"
                    ]
                  }
                }
              }
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Install",
            "Uninstall",
            "Repair"
          ],
          "properties": {
            "Install": {
              "$ref": "#/$defs/applicationDefinition/$defs/action"
            },
            "Uninstall": {
              "$ref": "#/$defs/applicationDefinition/$defs/action"
            },
            "Repair": {
              "$ref": "#/$defs/applicationDefinition/$defs/action"
            }
          }
        },
        "payloads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installer",
            "support"
          ],
          "properties": {
            "installer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "destination"
              ],
              "properties": {
                "destination": {
                  "$ref": "#/$defs/applicationDefinition/$defs/fileName"
                }
              }
            },
            "support": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "destination"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/$defs/applicationDefinition/$defs/relativePath"
                  },
                  "destination": {
                    "$ref": "#/$defs/applicationDefinition/$defs/relativePath"
                  }
                }
              }
            }
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "binding",
            "versionFormat",
            "runAs32Bit",
            "enforceSignatureCheck"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/applicationDefinition/$defs/relativePath"
            },
            "binding": {
              "const": "MinimumVersion"
            },
            "versionFormat": {
              "const": "numeric"
            },
            "runAs32Bit": {
              "const": false
            },
            "enforceSignatureCheck": {
              "type": "boolean"
            }
          }
        },
        "intune": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements",
            "returnCodes",
            "maximumInstallationTimeInMinutes"
          ],
          "properties": {
            "requirements": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumSupportedOperatingSystem",
                "applicability"
              ],
              "properties": {
                "minimumSupportedOperatingSystem": {
                  "const": "W11_22H2"
                },
                "applicability": {
                  "const": "fresh-or-upgrade"
                }
              }
            },
            "returnCodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "type"
                ],
                "properties": {
                  "code": {
                    "$ref": "#/$defs/applicationDefinition/$defs/exitCode"
                  },
                  "type": {
                    "enum": [
                      "success",
                      "softReboot",
                      "hardReboot",
                      "retry",
                      "failed"
                    ]
                  }
                }
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "maximumInstallationTimeInMinutes": {
              "const": 120
            }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pilotGroupId",
            "productionGroupId"
          ],
          "properties": {
            "pilotGroupId": {
              "$ref": "#/$defs/applicationDefinition/$defs/nullableGuid"
            },
            "productionGroupId": {
              "$ref": "#/$defs/applicationDefinition/$defs/nullableGuid"
            }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "selfUpdater",
            "retainedSuccessfulReleases",
            "productionApprovalRequired",
            "downgradeHandling"
          ],
          "properties": {
            "strategy": {
              "const": "new-app-per-release"
            },
            "selfUpdater": {
              "const": "centrally-controlled"
            },
            "retainedSuccessfulReleases": {
              "type": "integer",
              "minimum": 1
            },
            "productionApprovalRequired": {
              "const": true
            },
            "downgradeHandling": {
              "const": "vendor-default"
            }
          }
        }
      },
      "$defs": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "numericVersion": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}$)(?!.*[ .]$)[^<>:\"/\\\\|?*\\u0000-\\u001F]+$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[ .\\\\/]$)[^<>:\"|?*\\u0000-\\u001F]+$"
        },
        "nullableGuid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          ]
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Main"
          ],
          "properties": {
            "Pre": {
              "$ref": "#/$defs/applicationDefinition/$defs/relativePath"
            },
            "Main": {
              "$ref": "#/$defs/applicationDefinition/$defs/relativePath"
            },
            "Post": {
              "$ref": "#/$defs/applicationDefinition/$defs/relativePath"
            }
          }
        }
      }
    },
    "discoveredRelease": {
      "title": "Discovered release v1",
      "description": "Immutable discovery result. This record has not accepted an installer or deployment. Preserve source provenance without signed URLs or secrets.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "applicationId",
        "definitionSha256",
        "discoveryFingerprint",
        "version",
        "sourceUrl",
        "vendorSha256",
        "variant",
        "evergreenModuleVersion",
        "definitionsRelease",
        "discoveredAtUtc",
        "rawMetadata"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "DiscoveredRelease"
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definitionSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "discoveryFingerprint": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?(?:/[^?#\\s]*)?$",
          "description": "Unsigned HTTPS URL without user information, query string or fragment. Consumers also validate hosts and redirects."
        },
        "vendorSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "architecture",
            "language",
            "channel",
            "edition",
            "installerType",
            "versionPolicy",
            "targetVersion"
          ],
          "properties": {
            "architecture": {
              "const": "x64"
            },
            "language": {
              "type": "string",
              "minLength": 1,
