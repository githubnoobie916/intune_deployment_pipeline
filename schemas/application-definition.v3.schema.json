{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-lifecycle/application-definition.v3.schema.json",
  "title": "Application definition v3 — manual PSADT 4.1.8 native-v2 profile",
  "description": "One authored application definition. Scripts own executable commands. Release versions, validation decisions, generated metadata and tenant state are separate outputs. This schema validates supported shape; semantic, filesystem, evidence and runtime checks are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "publisher",
    "productName",
    "displayName",
    "description",
    "ownership",
    "source",
    "variant",
    "validation",
    "toolkit",
    "deployment",
    "actions",
    "payloads",
    "detection",
    "intune",
    "targets",
    "update"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "publisher": {
      "$ref": "#/$defs/text"
    },
    "productName": {
      "$ref": "#/$defs/text"
    },
    "displayName": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "contact",
        "recipeRevision"
      ],
      "properties": {
        "team": {
          "$ref": "#/$defs/text"
        },
        "contact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recipeRevision": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "application",
        "moduleVersion",
        "definitionsRelease",
        "selectionMap",
        "selectionConstants",
        "parameterMap"
      ],
      "properties": {
        "provider": {
          "const": "Evergreen"
        },
        "application": {
          "$ref": "#/$defs/text"
        },
        "moduleVersion": {
          "const": "2610.2859.0"
        },
        "definitionsRelease": {
          "const": "v26.11.03.146"
        },
        "selectionMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Architecture",
            "Type"
          ],
          "properties": {
            "Architecture": {
              "const": "architecture"
            },
            "Type": {
              "const": "installerType"
            },
            "Channel": {
              "const": "channel"
            },
            "Language": {
              "const": "language"
            }
          }
        },
        "selectionConstants": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "InstallerType": {
              "$ref": "#/$defs/text"
            },
            "UriSuffix": {
              "type": "string",
              "pattern": "^\\.[^\\\\/]+$"
            }
          }
        },
        "parameterMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "Language": {
              "const": "language"
            }
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "channel",
        "language",
        "architecture",
        "installerType",
        "versionPolicy",
        "targetVersion"
      ],
      "properties": {
        "edition": {
          "$ref": "#/$defs/text"
        },
        "channel": {
          "$ref": "#/$defs/text"
        },
        "language": {
          "$ref": "#/$defs/text"
        },
        "architecture": {
          "const": "x64"
        },
        "installerType": {
          "enum": [
            "msi",
            "exe"
          ]
        },
        "versionPolicy": {
          "enum": [
            "latest",
            "pinned"
          ]
        },
        "targetVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/numericVersion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "versionPolicy": {
                "const": "latest"
              }
            }
          },
          "then": {
            "properties": {
              "targetVersion": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "targetVersion": {
                "$ref": "#/$defs/numericVersion"
              }
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedDownloadHosts",
        "requireVendorSha256",
        "requireAuthenticode",
        "approvedSignerSubjects",
        "expectedProductName",
        "msiPropertiesToRecord"
      ],
      "properties": {
        "allowedDownloadHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requireVendorSha256": {
          "type": "boolean"
        },
        "requireAuthenticode": {
          "type": "boolean"
        },
        "approvedSignerSubjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "expectedProductName": {
          "$ref": "#/$defs/text"
        },
        "msiPropertiesToRecord": {
          "type": "array",
          "items": {
            "enum": [
              "ProductName",
              "ProductVersion",
              "ProductCode",
              "UpgradeCode",
              "Manufacturer",
              "ProductLanguage"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "toolkit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profile",
        "packageRevision",
        "scriptVersion",
        "scriptDate",
        "scriptAuthor",
        "requireAdmin",
        "successExitCodes",
        "rebootExitCodes"
      ],
      "properties": {
        "version": {
          "const": "4.1.8"
        },
        "profile": {
          "const": "official-4.1.8-native-v2"
        },
        "packageRevision": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "scriptVersion": {
          "$ref": "#/$defs/numericVersion"
        },
        "scriptDate": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scriptAuthor": {
          "$ref": "#/$defs/text"
        },
        "requireAdmin": {
          "const": true
        },
        "successExitCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exitCode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rebootExitCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exitCode"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "mode",
        "processes",
        "deferral",
        "repair",
        "prerequisites",
        "externalPolicyPrerequisites"
      ],
      "properties": {
        "context": {
          "const": "system"
        },
        "mode": {
          "const": "Auto"
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "description": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "uniqueItems": true
        },
        "deferral": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "const": "template-default"
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "reason"
          ],
          "properties": {
            "supported": {
              "const": false
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "externalPolicyPrerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "setting",
              "requiredValue"
            ],
            "properties": {
              "provider": {
                "const": "Intune"
              },
              "setting": {
                "$ref": "#/$defs/text"
              },
              "requiredValue": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Install",
        "Uninstall",
        "Repair"
      ],
      "properties": {
        "Install": {
          "$ref": "#/$defs/action"
        },
        "Uninstall": {
          "$ref": "#/$defs/action"
        },
        "Repair": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "payloads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installer",
        "support"
      ],
      "properties": {
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "destination"
          ],
          "properties": {
            "destination": {
              "$ref": "#/$defs/fileName"
            }
          }
        },
        "support": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/relativePath"
              },
              "destination": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "binding",
        "versionFormat",
        "runAs32Bit",
        "enforceSignatureCheck"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "binding": {
          "const": "MinimumVersion"
        },
        "versionFormat": {
          "const": "numeric"
        },
        "runAs32Bit": {
          "const": false
        },
        "enforceSignatureCheck": {
          "type": "boolean"
        }
      }
    },
    "intune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "returnCodes",
        "maximumInstallationTimeInMinutes"
      ],
      "properties": {
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumSupportedOperatingSystem",
            "applicability"
          ],
          "properties": {
            "minimumSupportedOperatingSystem": {
              "const": "W11_22H2"
            },
            "applicability": {
              "const": "fresh-or-upgrade"
            }
          }
        },
        "returnCodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "type"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/exitCode"
              },
              "type": {
                "enum": [
                  "success",
                  "softReboot",
                  "hardReboot",
                  "retry",
                  "failed"
                ]
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "maximumInstallationTimeInMinutes": {
          "const": 120
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pilotGroupId",
        "productionGroupId"
      ],
      "properties": {
        "pilotGroupId": {
          "$ref": "#/$defs/nullableGuid"
        },
        "productionGroupId": {
          "$ref": "#/$defs/nullableGuid"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "selfUpdater",
        "retainedSuccessfulReleases",
        "productionApprovalRequired",
        "downgradeHandling"
      ],
      "properties": {
        "strategy": {
          "const": "new-app-per-release"
        },
        "selfUpdater": {
          "const": "centrally-controlled"
        },
        "retainedSuccessfulReleases": {
          "type": "integer",
          "minimum": 1
        },
        "productionApprovalRequired": {
          "const": true
        },
        "downgradeHandling": {
          "const": "vendor-default"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "numericVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?!.*[ .]$)[^<>:\"/\\\\|?*\\u0000-\\u001F]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[ .\\\\/]$)[^<>:\"|?*\\u0000-\\u001F]+$"
    },
    "nullableGuid": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Main"
      ],
      "properties": {
        "Pre": {
          "$ref": "#/$defs/relativePath"
        },
        "Main": {
          "$ref": "#/$defs/relativePath"
        },
        "Post": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
