{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-lifecycle/discovered-release.v1.schema.json",
  "title": "Discovered release v1",
  "description": "Immutable discovery result. This record has not accepted an installer or deployment. Preserve source provenance without signed URLs or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "applicationId",
    "definitionSha256",
    "discoveryFingerprint",
    "version",
    "sourceUrl",
    "vendorSha256",
    "variant",
    "evergreenModuleVersion",
    "definitionsRelease",
    "discoveredAtUtc",
    "rawMetadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "DiscoveredRelease"
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "definitionSha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "discoveryFingerprint": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?(?:/[^?#\\s]*)?$",
      "description": "Unsigned HTTPS URL without user information, query string or fragment. Consumers also validate hosts and redirects."
    },
    "vendorSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "language",
        "channel",
        "edition",
        "installerType",
        "versionPolicy",
        "targetVersion"
      ],
      "properties": {
        "architecture": {
          "const": "x64"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "installerType": {
          "enum": [
            "msi",
            "exe"
          ]
        },
        "versionPolicy": {
          "enum": [
            "latest",
            "pinned"
          ]
        },
        "targetVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "versionPolicy": {
                "const": "latest"
              }
            }
          },
          "then": {
            "properties": {
              "targetVersion": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "targetVersion": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
              }
            }
          }
        }
      ]
    },
    "evergreenModuleVersion": {
      "const": "2610.2859.0"
    },
    "definitionsRelease": {
      "const": "v26.11.03.146"
    },
    "discoveredAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "rawMetadata": {
      "type": "object",
      "description": "Only known scalar provider fields; never URI, signed URLs, tokens or arbitrary nested metadata.",
      "additionalProperties": false,
      "properties": {
        "Version": {
          "type": [
            "string",
            "null"
          ]
        },
        "Architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "Type": {
          "type": [
            "string",
            "null"
          ]
        },
        "Channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "Language": {
          "type": [
            "string",
            "null"
          ]
        },
        "InstallerType": {
          "type": [
            "string",
            "null"
          ]
        },
        "Sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
